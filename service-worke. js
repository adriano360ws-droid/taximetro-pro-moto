
const CACHE_NAME = 'taximetro-v4';
const ARQUIVOS = [
  '/taximetro-pro-moto/',
  '/taximetro-pro-moto/index.html',
  '/taximetro-pro-moto/manifest.json',
  '/taximetro-pro-moto/icone-192.png',
  '/taximetro-pro-moto/icone-512.png'
];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(CACHE_NAME).then(cache => cache.addAll(ARQUIVOS)));
});

self.addEventListener('activate', e => {
  e.waitUntil(caches.keys().then(keys => Promise.all(keys.filter(k => k !== CACHE_NAME).map(k => caches.delete(k)))));
});

self.addEventListener('fetch', e => {
  e.respondWith(caches.match(e.request).then(res => res || fetch(e.request)));
});
