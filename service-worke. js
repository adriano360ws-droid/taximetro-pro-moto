const CACHE_NAME = 'taximetro-app-v3';
const ARQUIVOS = [
  '/taximetro-pro-moto/',
  '/taximetro-pro-moto/index.html',
  '/taximetro-pro-moto/manifest.json',
  '/taximetro-pro-moto/icone-192.png',
  '/taximetro-pro-moto/icone-512.png'
];

self.addEventListener('install', (e) => {
  e.waitUntil(
    caches.open(CACHE_NAME).then(cache => {
      return cache.addAll(ARQUIVOS);
    })
  );
});

self.addEventListener('activate', (e) => {
  e.waitUntil(
    caches.keys().then(nomes => {
      return Promise.all(
        nomes.filter(nome => nome !== CACHE_NAME).map(nome => caches.delete(nome))
      );
    })
  );
});

self.addEventListener('fetch', (e) => {
  e.respondWith(
    caches.match(e.request).then(resposta => {
      return resposta || fetch(e.request);
    })
  );
});
